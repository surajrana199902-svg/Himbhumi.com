# Copy this file to .env and fill in your own values
MONGO_URL=mongodb://localhost:27017
DB_NAME=himbhumi
NEXT_PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=*
# Google OAuth 2.0. Register /api/auth/google/callback as an authorized redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional role-specific clients; if unset, that role uses the shared client above.
GOOGLE_ADMIN_CLIENT_ID=
GOOGLE_ADMIN_CLIENT_SECRET=
GOOGLE_AGENT_CLIENT_ID=
GOOGLE_AGENT_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Generate a unique random secret of at least 32 characters for signing user sessions.
GOOGLE_OAUTH_SESSION_SECRET=
# Comma-separated Google account email allowlists; only these accounts get elevated roles.
ADMIN_GOOGLE_EMAILS=Surajrana2686@gmail.com,Suraj.rana199902@gmail.com,suraj86rana@gmail.com
AGENT_GOOGLE_EMAILS=

# Optional legacy single-agent username/password login (Google OAuth is preferred).
AGENT_USERNAME=
AGENT_PASSWORD=
AGENT_SESSION_SECRET=

# Email OTP via SMTP (Brevo relay example)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HimBhumi Real Estates <no-reply@yourdomain.com>
# Comma-separated recipients for new enquiry/message notifications.
ADMIN_NOTIFICATION_EMAILS=Surajrana2686@gmail.com,Suraj.rana199902@gmail.com,suraj86rana@gmail.com

# Optional cloud media storage (Cloudinary unsigned upload)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
